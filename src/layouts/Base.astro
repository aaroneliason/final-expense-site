---
import '@fontsource-variable/source-sans-3';
import '@fontsource-variable/source-serif-4';
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import CallBar from '../components/CallBar.astro';
import { SITE_MODE, brand, phone } from '../config/site';
import { graph } from '../lib/schema';

interface Props {
  title: string;
  description: string;
  path: string;
  lang?: 'en' | 'es';
  noindex?: boolean;
  jsonLd?: object[];
  /** hreflang alternates, including this page, e.g. [{ lang: 'en-US', path }, { lang: 'es-US', path: '/es/…/' }, { lang: 'x-default', path }] */
  alternates?: { lang: string; path: string }[];
  ogType?: 'website' | 'article';
  modified?: string; // ISO date, for article:modified_time
}

const { title, description, path, lang = 'en', noindex = false, jsonLd = [], alternates = [], ogType = 'website', modified } = Astro.props;
const site = Astro.site ?? new URL('https://preview.invalid');
const canonical = new URL(path, site).href;
const isPreview = SITE_MODE !== 'production';
const robots = isPreview || noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large';
// Keep titles short in search results: brand suffix is the short name unless the title already names us.
const fullTitle = title.includes(brand.shortName) ? title : `${title} | ${brand.shortName}`;
const ogImage = new URL('/og/olive-tree-1200x630.png', site).href;
const hasOtherLang = alternates.some((a) => a.lang.startsWith(lang === 'es' ? 'en' : 'es'));
// Analytics IDs are public values, set at build time. Nothing loads in preview builds.
const ga4 = import.meta.env.PUBLIC_GA4_ID as string | undefined;
const cfBeacon = import.meta.env.PUBLIC_CF_BEACON_TOKEN as string | undefined;
---
<!doctype html>
<html lang={lang === 'es' ? 'es-US' : 'en-US'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={new URL(a.path, site).href} />)}
    <meta name="theme-color" content="#14273b" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={brand.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === 'es' ? 'es_US' : 'en_US'} />
    {hasOtherLang && <meta property="og:locale:alternate" content={lang === 'es' ? 'en_US' : 'es_US'} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${brand.name}: ${brand.tagline}`} />
    <meta name="twitter:card" content="summary_large_image" />
    {ogType === 'article' && modified && <meta property="article:modified_time" content={modified} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    {jsonLd.length > 0 && <script type="application/ld+json" set:html={JSON.stringify(graph(...jsonLd))} />}
    {ga4 && !isPreview && (
      <>
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${ga4}`}></script>
        <script is:inline define:vars={{ ga4 }}>
          window.dataLayer = window.dataLayer || [];
          function gtag() { dataLayer.push(arguments); }
          window.gtag = gtag;
          gtag('js', new Date());
          gtag('config', ga4);
        </script>
      </>
    )}
    {cfBeacon && !isPreview && (
      <script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token: cfBeacon })}></script>
    )}
  </head>
  <body>
    <a class="skip-link" href="#main">{lang === 'es' ? 'Saltar al contenido' : 'Skip to main content'}</a>
    {isPreview && (
      <div class="preview-banner" role="region" aria-label="Preview notice">
        Preview build — not public, hidden from search engines. Items marked TODO must be filled and verified before launch.{/* check-publish-ignore */}
      </div>
    )}
    <SiteHeader lang={lang} path={path} alternates={alternates} />
    <main id="main">
      <slot />
    </main>
    <SiteFooter lang={lang} />
    <CallBar lang={lang} />
    <script is:inline define:vars={{ hours: phone.open }}>
      (() => {
        // Site-wide click tracking: call buttons (data-track="call") and other tracked links. GA4 when installed, else dataLayer.
        document.addEventListener('click', (e) => {
          const a = e.target && e.target.closest ? e.target.closest('[data-track]') : null;
          if (!a) return;
          const event = a.dataset.track === 'call' ? 'call_click' : a.dataset.track;
          const data = { location: a.dataset.location || 'unknown', page: location.pathname };
          if (typeof window.gtag === 'function') window.gtag('event', event, data);
          else (window.dataLayer = window.dataLayer || []).push({ event, ...data });
        });

        // Live "Open now / Closed now" next to call buttons, from the hours in src/config/site.ts (Eastern time).
        const els = document.querySelectorAll('[data-open-status]');
        if (!els.length) return;
        const es = document.documentElement.lang.startsWith('es');
        const parts = new Intl.DateTimeFormat('en-US', { timeZone: hours.tz, weekday: 'short', hour: 'numeric', hourCycle: 'h23' }).formatToParts(new Date());
        const day = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'].indexOf(parts.find((p) => p.type === 'weekday').value);
        const hour = Number(parts.find((p) => p.type === 'hour').value) % 24;
        const open = hours.days.includes(day) && hour >= hours.start && hour < hours.end;
        const t = (h) => `${((h + 11) % 12) + 1} ${es ? (h < 12 ? 'a. m.' : 'p. m.') : h < 12 ? 'AM' : 'PM'}`;
        const names = es ? ['el domingo', 'el lunes', 'el martes', 'el miércoles', 'el jueves', 'el viernes', 'el sábado'] : ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
        let next = '';
        for (let k = 0; k < 8 && !open; k++) {
          const d = (day + k) % 7;
          if ((k > 0 || hour < hours.start) && hours.days.includes(d)) {
            next = k === 0 ? (es ? 'hoy' : 'today') : k === 1 ? (es ? 'mañana' : 'tomorrow') : names[d];
            break;
          }
        }
        els.forEach((el) => {
          const short = el.dataset.variant === 'short';
          el.classList.add(open ? 'is-open' : 'is-closed');
          el.textContent = es
            ? open
              ? short ? `Abierto hasta las ${t(hours.end)} (ET)` : `Abierto ahora · un agente con licencia contesta hasta las ${t(hours.end)} (hora del Este)`
              : short ? `Abre ${next} a las ${t(hours.start)} (ET)` : `Cerrado ahora · abrimos ${next} a las ${t(hours.start)} (hora del Este). Déjenos su número y le llamamos.`
            : open
              ? short ? `Open now until ${t(hours.end)} ET` : `Open now · a licensed agent answers until ${t(hours.end)} ET`
              : short ? `Opens ${next} at ${t(hours.start)} ET` : `Closed now · we open ${next} at ${t(hours.start)} ET. Leave your number and we'll call you.`;
        });
      })();
    </script>
  </body>
</html>
