---
import Page from '../layouts/Page.astro';
import PhoneButton from '../components/PhoneButton.astro';
import { phone } from '../config/site';
---
<Page title="Thank you" h1="Thank you" description="Your request was received." path="/thank-you/" crumb="Thank you" noindex>
  <p class="lede" data-greet>Your request is in. A licensed agent will call you soon.</p>
  <p class="ref-box" data-ref hidden>Your reference number: <strong data-ref-code></strong><br /><span class="small">Mention it if you call us. It helps us find your request quickly.</span></p>

  <section class="ty-card" aria-labelledby="ty-save">
    <h2 id="ty-save" class="h3">Save our number so you know it's us</h2>
    <p>We'll call you from <strong class="nowrap">{phone.display}</strong>. Many people don't answer numbers they don't know, so saving it now means you won't miss the call.</p>
    <div class="btn-row">
      <a class="btn btn-primary" href="/olive-tree-insurance.vcf" download data-track="save_contact">Save to my contacts</a>
      <PhoneButton label="Call now" variant="outline" location="thank-you" />
    </div>
  </section>

  <section class="ty-card" aria-labelledby="ty-prep" data-enrich hidden>
    <h2 id="ty-prep" class="h3">Help us get ready for your call <span class="small">(optional)</span></h2>
    <form class="qf qf--plain" data-enrich-form novalidate>
      <label class="field" for="ty-last">Last name</label>
      <input id="ty-last" name="last_name" type="text" autocomplete="family-name" autocapitalize="words" spellcheck="false" />
      <label class="field" for="ty-time">Best time to call</label>
      <select id="ty-time" name="best_time">
        <option value="anytime">Any time</option>
        <option value="morning">Morning</option>
        <option value="afternoon">Afternoon</option>
        <option value="evening">Evening</option>
      </select>
      <label class="field" for="ty-lang">Language</label>
      <select id="ty-lang" name="language">
        <option value="en">English</option>
        <option value="es">Español</option>
      </select>
      <label class="field" for="ty-email">Email <span class="small">(optional)</span></label>
      <p class="qf-hint" id="ty-email-hint">Only to send you your quote details. Never sold or shared.</p>
      <input id="ty-email" name="email" type="email" autocomplete="email" spellcheck="false" aria-describedby="ty-email-hint" />
      <button class="btn btn-primary" type="submit" data-enrich-send>Send</button>
      <p class="ty-status" role="status" data-enrich-status></p>
    </form>
  </section>

  <h2 class="h3">What happens next</h2>
  <ul>
    <li><strong>When:</strong> as soon as we can, usually the same business day ({phone.hours}).</li>
    <li><strong>Who:</strong> a licensed agent, not a call center. There's no obligation to buy.</li>
    <li><strong>Have ready:</strong> the date of birth of the person to be covered and a list of their current medicines. It makes the call faster.</li>
  </ul>
</Page>
<script>
  const params = new URLSearchParams(location.search);
  const n = params.get('n');
  const el = document.querySelector('[data-greet]');
  if (n && el) el.textContent = `Thank you, ${n.slice(0, 40)}. Your request is in, and a licensed agent will call you soon.`;
  const ref = (params.get('ref') || '').replace(/[^A-Z0-9]/gi, '').slice(0, 8).toUpperCase();
  const box = document.querySelector<HTMLElement>('[data-ref]');
  const code = document.querySelector('[data-ref-code]');
  if (ref.length === 8 && box && code) {
    code.textContent = `${ref.slice(0, 4)}-${ref.slice(4)}`;
    box.hidden = false;
  }

  // Optional details: only offered right after a request from this browser tab (one-time token in sessionStorage).
  let saved: { id?: string; token?: string } = {};
  try {
    saved = JSON.parse(sessionStorage.getItem('ot_lead') || '{}');
  } catch {}
  const card = document.querySelector<HTMLElement>('[data-enrich]');
  const form = document.querySelector<HTMLFormElement>('[data-enrich-form]');
  const status = document.querySelector<HTMLElement>('[data-enrich-status]');
  const send = document.querySelector<HTMLButtonElement>('[data-enrich-send]');
  if (saved.id && saved.token && card && form && status && send) {
    card.hidden = false;
    let busy = false;
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (busy) return;
      busy = true;
      send.setAttribute('aria-disabled', 'true');
      status.textContent = 'Sending…';
      const data = Object.fromEntries(new FormData(form).entries());
      try {
        const res = await fetch('/api/lead-update', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ ...data, id: saved.id, token: saved.token }),
        });
        const out = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error(out.error || 'That didn’t go through.');
        status.textContent = 'Thank you. We added that to your request.';
        form.querySelectorAll<HTMLInputElement | HTMLSelectElement>('input, select').forEach((f) => (f.disabled = true));
        send.hidden = true;
        const w = window as Window & { gtag?: (...a: unknown[]) => void; dataLayer?: unknown[] };
        if (typeof w.gtag === 'function') w.gtag('event', 'lead_details');
        else (w.dataLayer = w.dataLayer || []).push({ event: 'lead_details' });
      } catch (ex) {
        status.textContent = `${(ex as Error).message} You can also tell the agent on the call.`;
        busy = false;
        send.removeAttribute('aria-disabled');
      }
    });
  }
</script>
