---
import Page from '../layouts/Page.astro';
import { agent, brand, licenses, links } from '../config/site';
const fmt = (d?: string) => (d ? new Date(d + 'T12:00:00').toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : '—');
---
<Page
  title={`Licenses: ${brand.name}`}
  h1="Licenses"
  description="Our Florida agency license and every state where our agent is licensed to sell life insurance, with numbers you can verify."
  path="/licenses/"
  crumb="Licenses"
  updated="2026-11-06"
>
  <p>
    {brand.name}: Florida insurance agency license <strong>{brand.agencyLicenseNumber}</strong>. Agent in charge: Florida resident license
    <strong>{agent.flLicense}</strong> · National Producer Number (NPN) <strong>{agent.npn}</strong>.
    Verify with <a href={links.dfsLookup} rel="noopener">Florida DFS</a> or <a href={links.nipr} rel="noopener">NIPR</a>.
  </p>
  <div class="table-wrap">
    <table>
      <caption>Agent life insurance licenses</caption>
      <thead><tr><th scope="col">State</th><th scope="col">Type</th><th scope="col">Renewal date</th></tr></thead>
      <tbody>
        {licenses.map((l) => (
          <tr>
            <td>{l.name}</td>
            <td>{l.resident ? 'Resident' : 'Non-resident'}</td>
            <td>{fmt(l.expires)}</td>
          </tr>
        ))}
      </tbody>
    </table>
    {/* TODO: before marketing any non-Florida state under the Olive Tree name, check that state's agency / assumed-name rules; if needed, list Florida only. */}
    <p class="table-note">Checked against NIPR on (TODO: date). If a license lapses, the state is removed from this site the same day.</p>
  </div>
</Page>
