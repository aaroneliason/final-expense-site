---
import Base from '../layouts/Base.astro';
import QuoteForm from '../components/QuoteForm.astro';
import TrustStrip from '../components/TrustStrip.astro';
import RateTable from '../components/RateTable.astro';
import Faq from '../components/Faq.astro';
import AuthorBox from '../components/AuthorBox.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CtaBand from '../components/CtaBand.astro';
import PhoneButton from '../components/PhoneButton.astro';
import Icon from '../components/Icon.astro';
import { agent, lastReviewed, links, nameableIn } from '../config/site';
import { agencyLd, articleLd, breadcrumbLd, personLd, websiteLd } from '../lib/schema';

const path = '/final-expense-insurance-florida/';
const title = 'Burial & Final Expense Insurance in Florida | Aaron Eliason, Licensed Agent';
const description =
  'Plain answers and real sample prices for final expense and burial insurance in Florida, from a licensed independent agent. Compare several insurers in one call. Se habla español.';
const site = Astro.site!;
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Final expense insurance in Florida', path },
];
const jsonLd = [
  websiteLd(site),
  agencyLd(site),
  personLd(site),
  breadcrumbLd(site, crumbs),
  articleLd(site, { path, headline: 'Final expense and burial insurance in Florida', description, datePublished: '2026-11-06', dateModified: lastReviewed }),
];
const carrierNames = nameableIn('FL').map((c) => c.shortName);

const faqs = [
  {
    q: 'How much does final expense insurance cost in Florida?',
    a: `<p>It depends on age, sex, health, tobacco use and how much coverage you want. A healthy 65-year-old buying $10,000 usually pays far less than an 80-year-old with health problems. See the <a href="#rates">sample rates above</a>, each with the insurer named, or <a href="/final-expense-insurance-cost/">the full guide to costs</a>.</p>`,
  },
  {
    q: 'Can I get coverage if I have diabetes, COPD or heart problems?',
    a: `<p>Often, yes. Many insurers accept conditions that are under control, sometimes at regular rates. Others offer a plan with a waiting period. Aaron asks the health questions privately on the call and tells you honestly which plans you can qualify for.</p>`,
  },
  {
    q: 'Is there a medical exam?',
    a: `<p>No exam and no needles on the final expense plans Aaron offers. Instead there are health questions, and with your permission the insurer usually checks your prescription history and medical records databases. That's why answering honestly matters: a wrong answer can cause problems for your family later.</p>`,
  },
  {
    q: 'How fast does coverage start?',
    a: `<p>Many insurers give a decision during the phone call. Coverage starts once the insurer approves the application and the first premium is paid. Plans with a waiting period pay the full benefit for natural causes only after that period, usually two years.</p>`,
  },
  {
    q: 'Will my premium go up as I get older?',
    a: `<p>On the whole life plans used for final expense, the premium is normally set when you buy and doesn't rise with age, and the coverage doesn't expire while premiums are paid. Your policy spells out the exact terms. Ask Aaron to show you before you apply.</p>`,
  },
  {
    q: 'Can I cancel if I change my mind?',
    a: `<p>Yes. Policies sold by phone in Florida usually let you cancel for a full refund for at least 14 days after the policy arrives (<a href="${links.flRefundStatute}" rel="noopener">Florida Statutes 626.99</a>), and some insurers allow 30. Your policy states the exact deadline. After that you can still stop paying, but premiums already paid aren't refunded.</p>`,
  },
  {
    q: 'Who pays Aaron?',
    a: `<p>The insurance company pays Aaron a commission when a policy is issued. You don't pay him anything, and buying through him doesn't change the premium the insurer charges. <a href="/about/">How Aaron is paid</a>.</p>`,
  },
  {
    q: 'Will you sell my phone number?',
    a: `<p>No. What you share goes only to Aaron. It's never sold, rented or passed to other agents, and you can ask him to stop contacting you at any time. <a href="/privacy/">Privacy policy</a>.</p>`,
  },
];
---
<Base {title} {description} {path} {jsonLd}>
  <section class="hero">
    <div class="wrap">
      <Breadcrumbs items={crumbs} />
      <div class="grid-2">
        <div>
          <span class="eyebrow">Florida · Licensed independent agent</span>
          <h1>Final expense &amp; burial insurance in Florida</h1>
          <p class="lede">
            Plain answers and real prices from Aaron Eliason, a Florida-licensed agent. Compare several insurers in one call, and apply by
            phone if a plan fits.
          </p>
          <ul class="checks">
            <li><Icon name="check" /> Coverage from about $5,000 to $25,000 for a funeral, burial or cremation and final bills</li>
            <li><Icon name="check" /> No medical exam. Approval depends on your answers to a few health questions.</li>
            <li><Icon name="check" /> Options for many health conditions, explained honestly</li>
          </ul>
          <div class="btn-row">
            <PhoneButton label="Call Aaron" location="hero" />
            <a class="btn btn-outline" href="#quote">Get a quote online</a>
          </div>
          <div class="agent-chip">
            {agent.photo ? <img src={agent.photo} alt="" width="60" height="60" /> : <span class="avatar" aria-hidden="true">AE</span>}
            <p>
              <strong>{agent.name}</strong>, licensed life insurance agent<br />
              Florida license {agent.flLicense} · NPN {agent.npn} · <a href={links.dfsLookup} rel="noopener">Verify with Florida DFS</a>
            </p>
          </div>
        </div>
        <QuoteForm id="quote" heading="See your options in Florida" defaultState="FL" />
      </div>
    </div>
  </section>

  <section class="section section--white">
    <div class="wrap">
      <TrustStrip />
    </div>
  </section>

  <section class="section">
    <div class="wrap grid-2">
      <div class="prose">
        <span class="eyebrow">What it is</span>
        <h2>Small whole life insurance that pays for a funeral and final bills</h2>
        <p>
          Final expense insurance, also called burial insurance, is a small whole life insurance policy, usually $5,000 to $25,000. When you die, it pays
          your beneficiary in cash. Families use it for the funeral, burial or cremation, a headstone, medical bills or anything else.
        </p>
        <p>
          Most insurers accept applicants between about 50 and 85 (the limits vary by insurer). The policy is sold by private insurance
          companies, and you pay a monthly premium.
        </p>
      </div>
      <div class="callout callout--warn">
        <h3>It isn't a government program, and it isn't free</h3>
        <p>
          Some mailers and ads call this a "state program" or "government burial benefit." That's not true. These are private policies you pay
          for. <a href="/government-burial-insurance/">What government help really exists</a>.
        </p>
      </div>
    </div>
  </section>

  <section class="section section--sand">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">How it works</span>
        <h2>Four steps, usually in one phone call</h2>
      </div>
      <ol class="steps">
        <li><h3>Call or answer six questions</h3><p>Online or by phone, whichever is easier for you.</p></li>
        <li><h3>Aaron compares insurers</h3><p>He checks prices and health rules with the insurers he's appointed with.</p></li>
        <li><h3>Pick a plan, or don't</h3><p>He explains the options in plain words. No pressure to decide on the spot.</p></li>
        <li><h3>Apply by phone</h3><p>Many insurers give a decision during the call. Coverage starts once approved and the first premium is paid.</p></li>
      </ol>
    </div>
  </section>

  <section class="section" id="rates">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">Sample prices</span>
        <h2>What final expense insurance costs in Florida</h2>
        <p>
          These are real sample quotes for a healthy, non-tobacco applicant, with the insurer and plan named on every row as Florida requires.
          Your own price depends on your age, health, tobacco use and coverage.
        </p>
      </div>
      <RateTable />
      <p style="margin-top:1.25rem"><a href="/final-expense-insurance-cost/">How prices change with age, health and coverage →</a></p>
    </div>
  </section>

  <section class="section section--white">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">Which plan fits</span>
        <h2>Simplified issue or guaranteed issue?</h2>
        <p>The health questions decide which kind of plan you can get. If your health allows it, a plan without a waiting period is usually the better deal.</p>
      </div>
      <div class="compare">
        <div class="card">
          <h3>Simplified issue <span class="tag">Full coverage day one</span></h3>
          <p>A few yes-or-no health questions, no exam. If you qualify, the full benefit is paid from the first day on most plans.</p>
        </div>
        <div class="card">
          <h3>Graded or modified <span class="tag tag--sand">Waiting period</span></h3>
          <p>For some health histories. If death from natural causes happens in the first two years, the insurer usually refunds the premiums plus interest instead of the full amount. Accidental death is usually covered in full from the start.</p>
        </div>
        <div class="card">
          <h3>Guaranteed issue <span class="tag tag--sand">No health questions</span></h3>
          <p>Anyone in the age range is accepted, but there's always a waiting period, usually two years, and the price is higher. It's a good fallback when nothing else fits.</p>
        </div>
      </div>
      <p style="margin-top:1.25rem"><a href="/guaranteed-issue-vs-simplified-issue/">Compare the plan types in detail →</a></p>
    </div>
  </section>

  <section class="section">
    <div class="wrap grid-2">
      <div class="prose">
        <span class="eyebrow">Florida specifics</span>
        <h2>What's different about buying in Florida</h2>
        <h3>Check any agent's license</h3>
        <p>
          Florida's Department of Financial Services lets anyone look up an agent's license. Aaron's Florida license number is
          {agent.flLicense}. <a href={links.dfsLookup} rel="noopener">Search it yourself</a> before you share anything.
        </p>
        <h3>Time to change your mind</h3>
        <p>
          Florida law requires an insurer either to give you a buyer's guide before you pay, or to let you cancel for a full refund for at least
          14 days after the policy arrives (<a href={links.flRefundStatute} rel="noopener">Florida Statutes 626.99</a>). Policies sold by phone
          usually come with the refund window, and some insurers allow 30 days. The exact deadline is printed in your policy.
        </p>
        <h3>Se habla español</h3>
        <p>Aaron can walk you and your family through every question in Spanish, including what your beneficiaries need to do later.</p>
      </div>
      <aside class="card">
        <h3>What funerals cost today</h3>
        <p>
          The National Funeral Directors Association's 2023 price study put the national median at about <strong>$8,300</strong> for a
          funeral with viewing and burial, and about <strong>$6,280</strong> with cremation. Cemetery costs, like the plot and headstone, are
          extra.
        </p>
        <p class="small">Prices vary a lot between funeral homes. Under the FTC's Funeral Rule, every funeral home must give you an itemized price list.</p>
      </aside>
    </div>
  </section>

  <section class="section section--sand">
    <div class="wrap prose">
      <span class="eyebrow">Straight talk</span>
      <h2>Is there a government burial program?</h2>
      <p>
        No. There's no government burial insurance for the general public, in Florida or nationally. Here's what does exist, so you can count it in your plans:
      </p>
      <ul>
        <li><strong>Social Security</strong> pays a one-time <strong>$255</strong> death payment to an eligible surviving spouse or child. <a href={links.ssaDeath} rel="noopener">Details at ssa.gov</a>.</li>
        <li><strong>Veterans</strong> may qualify for VA burial benefits and burial in a national cemetery. <a href={links.vaBurial} rel="noopener">Details at va.gov</a>.</li>
        <li><strong>Veterans with a service-connected disability</strong> can apply for VALife, the VA's own whole life insurance. <a href={links.valife} rel="noopener">About VALife</a>.</li>
      </ul>
      <p>For most families, those benefits don't cover a full funeral, which is why people buy final expense insurance.</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">Questions</span>
        <h2>Common questions from Florida families</h2>
      </div>
      <div class="prose" style="max-width:48rem">
        <Faq items={faqs} />
      </div>
    </div>
  </section>

  <section class="section section--white">
    <div class="wrap grid-2">
      <div class="prose">
        <span class="eyebrow">Who you'll talk to</span>
        <h2>About Aaron and how he's paid</h2>
        <p>
          Aaron Eliason is an independent life insurance agent based in {agent.city}, licensed since {agent.licensedSince}. He helps families by
          phone across Florida and the other states where he's licensed, in English and Spanish.
        </p>
        <p>
          Because he's independent, he can compare plans from several insurers{carrierNames.length ? ` (including ${carrierNames.join(', ')})` : ''}.
          The insurer pays him a commission when a policy is issued; you never pay him, and your premium is the same as buying from the insurer
          directly.
        </p>
        <p><a href="/about/">More about Aaron →</a></p>
      </div>
      <QuoteForm id="quote-2" heading="Ready when you are" defaultState="FL" />
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <CtaBand />
      <div class="prose">
        <AuthorBox />
      </div>
    </div>
  </section>
</Base>
