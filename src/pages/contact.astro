---
import Page from '../layouts/Page.astro';
import PhoneButton from '../components/PhoneButton.astro';
import QuoteForm from '../components/QuoteForm.astro';
import { agent, brand, phone } from '../config/site';
---
<Page
  title="Contact Aaron Eliason"
  h1="Contact"
  description="Call or message Aaron Eliason, licensed life insurance agent, about final expense or burial insurance. English or Spanish."
  path="/contact/"
  crumb="Contact"
>
  <p class="lede">The fastest way to get answers is a phone call. You'll talk to {agent.name} himself.</p>
  <div class="btn-row"><PhoneButton label="Call" location="contact" /></div>
  <p><strong>Hours:</strong> {phone.hours} · <strong>Email:</strong> <a href={`mailto:${brand.email}`}>{brand.email}</a></p>
  <p>Prefer a call back? Answer the questions below and Aaron will call you at the time you choose.</p>
  <QuoteForm id="quote" heading="Ask for a call back" />
</Page>
