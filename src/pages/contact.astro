---
import Page from '../layouts/Page.astro';
import PhoneButton from '../components/PhoneButton.astro';
import QuoteForm from '../components/QuoteForm.astro';
import { brand, phone } from '../config/site';
---
<Page
  title={`Contact ${brand.name}`}
  h1="Contact"
  description="Talk with a licensed agent about final expense or burial insurance, in English or Spanish. Call, or ask for a call back."
  path="/contact/"
  crumb="Contact"
>
  <p class="lede">The fastest way to get answers is a phone call. You'll talk with a licensed agent, not a call center.</p>
  <div class="btn-row"><PhoneButton label="Call" location="contact" /></div>
  <p><strong>Hours:</strong> {phone.hours} · <strong>Email:</strong> <a href={`mailto:${brand.email}`}>{brand.email}</a></p>
  <p>Prefer a call back? Answer the questions below and we'll call you at the time you choose.</p>
  <QuoteForm id="quote" heading="Ask for a call back" />
</Page>
