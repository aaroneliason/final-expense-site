---
import PhoneButton from './PhoneButton.astro';
import OpenStatus from './OpenStatus.astro';
import { agent, phone } from '../config/site';
interface Props {
  lang?: 'en' | 'es';
}
const { lang = 'en' } = Astro.props;
---
<div class="callbar" role="region" aria-label={lang === 'es' ? 'Llamar' : 'Call'}>
  <PhoneButton label={lang === 'es' ? 'Llámenos' : 'Call us'} location="callbar" />
  <small>
    <OpenStatus short /> · {lang === 'es' ? 'Agente con licencia' : 'Licensed agent'} · FL {agent.flLicense}
  </small>
</div>
