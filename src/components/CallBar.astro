---
import PhoneButton from './PhoneButton.astro';
import OpenStatus from './OpenStatus.astro';
import { agent } from '../config/site';
import { ui, type Lang } from '../i18n/ui';
interface Props {
  lang?: Lang;
}
const { lang = 'en' } = Astro.props;
const t = ui[lang].callbar;
---
<div class="callbar" role="region" aria-label={t.region}>
  <PhoneButton label={t.call} location="callbar" />
  <small>
    <OpenStatus short lang={lang} /> · {t.licensedAgent} · FL {agent.flLicense}
  </small>
</div>
