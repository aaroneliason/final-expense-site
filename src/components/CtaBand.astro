---
import PhoneButton from './PhoneButton.astro';
import { phone } from '../config/site';
import { fill, ui, type Lang } from '../i18n/ui';
interface Props {
  heading?: string;
  text?: string;
  lang?: Lang;
}
const { lang = 'en' } = Astro.props;
const t = ui[lang].cta;
const heading = Astro.props.heading ?? t.heading;
const text = Astro.props.text ?? fill(t.text, { hours: lang === 'es' ? phone.hoursEs : phone.hours });
---
<div class="cta-band">
  <div>
    <h2>{heading}</h2>
    <p>{text}</p>
  </div>
  <div class="btn-row" style="margin:0">
    <PhoneButton label={t.call} location="cta-band" />
    <a class="btn btn-outline" href="#quote">{t.quote}</a>
  </div>
</div>
