---
/**
 * Small row of real headshots for the hero ("the licensed agents you'll talk to").
 * Shows only team members with a photo on disk and written OK (src/data/team.json); renders nothing otherwise.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import team from '../data/team.json';

type Member = { id: string; displayName: string; role: string; photo: string | null; consent: boolean };
const photos = import.meta.glob<{ default: ImageMetadata }>('../assets/team/*.{jpg,jpeg,png,webp}', { eager: true });
const members = (team.members as Member[])
  .filter((m) => m.consent && m.photo && !m.displayName.startsWith('TODO')) // check-publish-ignore
  .map((m) => ({ ...m, img: photos[`../assets/team/${m.photo}`]?.default }))
  .filter((m) => m.img);
---
{members.length > 0 && (
  <a class="team-strip" href="/about/" aria-label="Meet the licensed agents you'll talk to">
    <span class="team-faces">
      {members.slice(0, 4).map((m) => (
        <Image src={m.img!} alt="" width={56} height={56} class="team-face" />
      ))}
    </span>
    <span class="team-strip-text"><strong>Licensed agents, not a call center.</strong> Meet the team you'll talk to.</span>
  </a>
)}
