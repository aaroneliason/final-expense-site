---
import Icon from './Icon.astro';
import { agent, licenses, links } from '../config/site';
---
{/* TODO: before launch, confirm ≥2 insurers are appointed in Florida AND have approved this page; otherwise reword "Several insurers" (DFS showed only Fidelity Life, American General, United of Omaha on 2026-11-06). */}
<div class="trust">
  <div class="trust-item">
    <Icon name="badge" />
    <p><strong>Licensed in {licenses.length} states</strong><br />Florida license {agent.flLicense}. <a href={links.dfsLookup} rel="noopener">Check it with Florida DFS</a>.</p>
  </div>
  <div class="trust-item">
    <Icon name="scale" />
    <p><strong>Several insurers, one call</strong><br />An independent agent compares carriers instead of selling one company's plan.</p>
  </div>
  <div class="trust-item">
    <Icon name="chat" />
    <p><strong>You talk to Aaron</strong><br />Not a call center. No pressure, and your number is never sold.</p>
  </div>
  <div class="trust-item">
    <Icon name="globe" />
    <p><strong>Se habla español</strong><br />Aaron can explain everything in English or Spanish.</p>
  </div>
</div>
