---
import Icon from './Icon.astro';
import { agent, licenses, links } from '../config/site';
---
{/* "Several insurers" is checked by scripts/check-publish.mjs against src/data/carriers.json (needs 2+ insurers writable in Florida). */}
<div class="trust">
  <div class="trust-item">
    <Icon name="badge" />
    <p><strong>Licensed in {licenses.length} states</strong><br />Florida license {agent.flLicense}. <a href={links.dfsLookup} rel="noopener">Check it with Florida DFS</a>.</p>
  </div>
  <div class="trust-item">
    <Icon name="scale" />
    <p><strong>Several insurers, one call</strong><br />An independent agent compares carriers instead of selling one company's plan.</p>
  </div>
  <div class="trust-item">
    <Icon name="chat" />
    <p><strong>A licensed agent, not a call center</strong><br />No pressure, and your number is never sold.</p>
  </div>
  <div class="trust-item">
    <Icon name="globe" />
    <p><strong>Se habla español</strong><br />We can explain everything in English or Spanish.</p>
  </div>
</div>
