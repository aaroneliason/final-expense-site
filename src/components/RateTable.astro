---
/**
 * Sample prices as one small table per insurer and plan: ages down the side, women and men across.
 * Easier to scan than one long row per quote, and the insurer, plan and quote date sit in the caption
 * so they're named with every price (Fla. Rule 69B-150.114). English or Spanish labels.
 */
import { sampleRates, type RateRow } from '../data/rates';
import { fill, ui, type Lang } from '../i18n/ui';
interface Props {
  rows?: RateRow[];
  caption?: string;
  lang?: Lang;
}
const { rows = sampleRates, caption, lang = 'en' } = Astro.props;
const t = ui[lang].rates;
const locale = lang === 'es' ? 'es-US' : 'en-US';
const money = (n: number) => n.toLocaleString('en-US', { style: 'currency', currency: 'USD', minimumFractionDigits: 2 });
const dollars = (n: number) => n.toLocaleString('en-US', { style: 'currency', currency: 'USD', maximumFractionDigits: 0 });
const month = (iso: string) => new Date(iso + 'T12:00:00').toLocaleDateString(locale, { month: 'long', year: 'numeric' });

const groups = new Map<string, RateRow[]>();
for (const r of rows) {
  const key = r.placeholder ? 'placeholder' : [r.insurer, r.plan, r.benefit, r.face, r.tobacco, r.quotedOn].join('|');
  groups.set(key, [...(groups.get(key) ?? []), r]);
}
const anyPlaceholder = rows.some((r) => r.placeholder);
const tables = [...groups.values()].map((g) => {
  const f = g[0];
  return {
    title: caption ?? (f.placeholder ? t.placeholderTitle : `${f.insurer}: ${f.plan}`),
    detail: f.placeholder
      ? fill(t.placeholderDetail, { face: dollars(f.face) })
      : fill(t.detail, { face: dollars(f.face), tobacco: f.tobacco ? t.tobacco : t.nonTobacco, benefit: t.benefit[f.benefit] ?? f.benefit.toLowerCase(), month: month(f.quotedOn) }),
    ages: [...new Set(g.map((r) => r.age))].sort((a, b) => a - b),
    cell: (age: number, sex: RateRow['sex']) => g.find((r) => r.age === age && r.sex === sex),
  };
});
---
{tables.map((tb) => (
  <div class="table-wrap">
    <table class="rates">
      <caption>{tb.title}{' '}<span class="caption-sub">{tb.detail}</span></caption>
      <thead>
        <tr><th scope="col">{t.age}</th><th scope="col" class="num">{t.women}</th><th scope="col" class="num">{t.men}</th></tr>
      </thead>
      <tbody>
        {tb.ages.map((age) => (
          <tr>
            <th scope="row">{age}</th>
            {(['Female', 'Male'] as const).map((sex) => {
              const r = tb.cell(age, sex);
              return <td class="num">{!r ? '—' : r.monthly == null ? <span class="tag tag--todo">TODO</span> : `${money(r.monthly)}${t.perMonth}`}</td>;{/* check-publish-ignore */}
            })}
          </tr>
        ))}
      </tbody>
    </table>
  </div>
))}
<p class="table-note">{anyPlaceholder ? t.notePlaceholder : t.noteReal}</p>
