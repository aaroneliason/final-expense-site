---
/**
 * Multi-step quote form (one question per screen). Works without JavaScript as a single
 * form that posts to /api/lead. Consent sits next to submit, unchecked, and names ONE seller.
 * Health detail is NOT collected here — it belongs on the call.
 */
import Icon from './Icon.astro';
import { brand, licenses, phone, turnstile } from '../config/site';
import { CONSENT_VERSION, consentText } from '../lib/consent';

interface Props {
  id?: string;
  heading?: string;
  defaultState?: string;
}
const { id = 'quote', heading = 'See your options', defaultState = 'FL' } = Astro.props;
const consent = consentText(brand.name);
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || turnstile.siteKey;
---
<form class="qf" id={id} method="post" action="/api/lead" novalidate data-quote-form>
  <div class="qf-head">
    <h2 class="h3">{heading}</h2>
    <span class="qf-count" aria-live="polite" data-count>6 quick questions</span>
  </div>
  <p class="qf-sub">A licensed agent calls you with prices from several insurers, usually the same business day. No obligation.</p>
  <div class="qf-bar" aria-hidden="true"><span data-bar></span></div>

  <div class="qf-step is-active" data-step="1">
    <fieldset data-error-msg="Select who the coverage is for">
      <legend>Who is the coverage for?</legend>
      <p class="field-error" id={`${id}-err-for`} data-error-slot hidden></p>
      <div class="qf-options qf-options--2">
        <label class="qf-option"><input type="radio" name="for" value="myself" required /> Myself</label>
        <label class="qf-option"><input type="radio" name="for" value="spouse" /> My spouse or partner</label>
        <label class="qf-option"><input type="radio" name="for" value="parent" /> A parent</label>
        <label class="qf-option"><input type="radio" name="for" value="other" /> Someone else</label>
      </div>
      <p class="qf-help" style="margin-top:.8rem">The person being covered takes part in the application and signs it.</p>
    </fieldset>
  </div>

  <div class="qf-step" data-step="2">
    <fieldset data-error-msg="Select an age range">
      <legend>How old is the person to be covered?</legend>
      <p class="field-error" id={`${id}-err-age`} data-error-slot hidden></p>
      <div class="qf-options qf-options--2">
        <label class="qf-option"><input type="radio" name="age" value="under-50" required /> Under 50</label>
        <label class="qf-option"><input type="radio" name="age" value="50-59" /> 50–59</label>
        <label class="qf-option"><input type="radio" name="age" value="60-69" /> 60–69</label>
        <label class="qf-option"><input type="radio" name="age" value="70-79" /> 70–79</label>
        <label class="qf-option"><input type="radio" name="age" value="80-85" /> 80–85</label>
        <label class="qf-option"><input type="radio" name="age" value="over-85" /> Over 85</label>
      </div>
    </fieldset>
  </div>

  <div class="qf-step" data-step="3">
    <label class="field" for={`${id}-state`}>Which state do they live in?</label>
    <select id={`${id}-state`} name="state" required>
      {licenses.map((l) => <option value={l.code} selected={l.code === defaultState}>{l.name}</option>)}
      <option value="other">Another state</option>
    </select>
    <p class="qf-help" data-other-state hidden>
      We can only help in states where we're licensed. Leave your number and we'll tell you honestly if we can't help.
    </p>
  </div>

  <div class="qf-step" data-step="4">
    <fieldset data-error-msg="Select a coverage amount">
      <legend>About how much coverage?</legend>
      <p class="field-error" id={`${id}-err-coverage`} data-error-slot hidden></p>
      <p class="qf-help">Most families choose enough to cover a funeral and final bills.</p>
      <div class="qf-options qf-options--2">
        <label class="qf-option"><input type="radio" name="coverage" value="5000" required /> $5,000</label>
        <label class="qf-option"><input type="radio" name="coverage" value="10000" /> $10,000</label>
        <label class="qf-option"><input type="radio" name="coverage" value="15000" /> $15,000</label>
        <label class="qf-option"><input type="radio" name="coverage" value="20000" /> $20,000</label>
        <label class="qf-option"><input type="radio" name="coverage" value="25000" /> $25,000</label>
        <label class="qf-option"><input type="radio" name="coverage" value="unsure" /> Not sure yet</label>
      </div>
    </fieldset>
  </div>

  <div class="qf-step" data-step="5">
    <fieldset data-error-msg="Select yes or no for tobacco">
      <legend>Any tobacco or nicotine in the last 12 months?</legend>
      <p class="field-error" id={`${id}-err-tobacco`} data-error-slot hidden></p>
      <div class="qf-options qf-options--2">
        <label class="qf-option"><input type="radio" name="tobacco" value="no" required /> No</label>
        <label class="qf-option"><input type="radio" name="tobacco" value="yes" /> Yes</label>
      </div>
    </fieldset>
    <fieldset data-error-msg="Select yes, no or not sure for health conditions">
      <legend>Any major health conditions?</legend>
      <p class="field-error" id={`${id}-err-health`} data-error-slot hidden></p>
      <p class="qf-help">Just yes or no for now. A licensed agent goes over the details privately on the call.</p>
      <div class="qf-options">
        <label class="qf-option"><input type="radio" name="health" value="no" required /> No</label>
        <label class="qf-option"><input type="radio" name="health" value="yes" /> Yes</label>
        <label class="qf-option"><input type="radio" name="health" value="unsure" /> Not sure</label>
      </div>
    </fieldset>
  </div>

  <div class="qf-step" data-step="6">
    <p class="qf-step-title">Where should a licensed agent call you?</p>
    <label class="field" for={`${id}-first`}>First name</label>
    <p class="field-error" id={`${id}-err-first_name`} data-error-slot hidden></p>
    <input id={`${id}-first`} name="first_name" type="text" autocomplete="given-name" autocapitalize="words" spellcheck="false" required data-error-msg="Enter a first name" />
    <label class="field" for={`${id}-phone`}>Phone number</label>
    <p class="qf-hint" id={`${id}-phone-hint`}>So a licensed agent can call you with your prices. We never sell it.</p>
    <p class="field-error" id={`${id}-err-phone`} data-error-slot hidden></p>
    <input id={`${id}-phone`} name="phone" type="tel" inputmode="tel" autocomplete="tel" required aria-describedby={`${id}-phone-hint`} data-error-msg="Enter a phone number" data-error-format="Enter a 10-digit phone number, like (407) 555-0123" />
    <div class="visually-hidden" aria-hidden="true">
      <label>Leave this empty <input type="text" name="company_website" tabindex="-1" autocomplete="off" /></label>
    </div>
    <p class="field-error" id={`${id}-err-consent`} data-error-slot hidden></p>
    <label class="consent">
      <input type="checkbox" name="consent" value="yes" required data-error-msg="Check the box so we can call you, or call us directly" />
      <span set:html={consent.html} />
    </label>
    <div class="cf-turnstile" data-sitekey={turnstileSiteKey} data-size="flexible" data-turnstile></div>
    <input type="hidden" name="consent_version" value={CONSENT_VERSION} />
    <input type="hidden" name="page" value="" data-page />
    <input type="hidden" name="utm" value="" data-utm />
  </div>

  <p class="qf-error" role="alert" data-error hidden></p>

  <div class="qf-nav">
    <button type="button" class="qf-back" data-back hidden>← Back</button>
    <button type="button" class="btn btn-primary" data-next>Next <Icon name="arrow" /></button>
    <button type="submit" class="btn btn-primary btn-block" data-submit>Get my quote</button>
  </div>
  <p class="qf-alt">
    Rather talk now? <a href={`tel:${phone.tel}`} data-track="call" data-location="form">Call us at {phone.display}</a>
  </p>
</form>

<script>
  type W = Window & { dataLayer?: unknown[]; turnstile?: unknown; gtag?: (...args: unknown[]) => void };
  const w = window as W;
  // Sends to GA4 when it's installed (PUBLIC_GA4_ID), otherwise just queues on dataLayer.
  const track = (event: string, data: Record<string, unknown> = {}) => {
    if (typeof w.gtag === 'function') w.gtag('event', event, data);
    else (w.dataLayer = w.dataLayer || []).push({ event, ...data });
  };

  document.addEventListener('click', (e) => {
    const a = (e.target as HTMLElement).closest('[data-track="call"]') as HTMLElement | null;
    if (a) track('call_click', { location: a.dataset.location || 'unknown', page: location.pathname });
  });

  document.querySelectorAll<HTMLFormElement>('[data-quote-form]').forEach((form) => {
    const steps = Array.from(form.querySelectorAll<HTMLElement>('.qf-step'));
    const total = steps.length;
    const bar = form.querySelector<HTMLElement>('[data-bar]')!;
    const count = form.querySelector<HTMLElement>('[data-count]')!;
    const back = form.querySelector<HTMLButtonElement>('[data-back]')!;
    const next = form.querySelector<HTMLButtonElement>('[data-next]')!;
    const submit = form.querySelector<HTMLButtonElement>('[data-submit]')!;
    const err = form.querySelector<HTMLElement>('[data-error]')!;
    const otherState = form.querySelector<HTMLElement>('[data-other-state]');
    let i = 0;
    let started = false;

    form.classList.add('qf-js');
    (form.querySelector('[data-page]') as HTMLInputElement).value = location.pathname;
    const params = new URLSearchParams(location.search);
    const utm = ['utm_source', 'utm_medium', 'utm_campaign', 'utm_term', 'gclid']
      .filter((k) => params.get(k))
      .map((k) => `${k}=${params.get(k)}`)
      .join('&');
    (form.querySelector('[data-utm]') as HTMLInputElement).value = utm || `ref=${document.referrer || 'direct'}`;

    let turnstileLoaded = false;
    const loadTurnstile = () => {
      if (turnstileLoaded) return;
      turnstileLoaded = true;
      const s = document.createElement('script');
      s.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js';
      s.async = true;
      s.defer = true;
      document.head.appendChild(s);
    };

    const render = () => {
      steps.forEach((s, n) => s.classList.toggle('is-active', n === i));
      bar.style.width = `${Math.round(((i + 1) / total) * 100)}%`;
      count.textContent = `Question ${i + 1} of ${total}`;
      back.hidden = i === 0;
      next.hidden = i === total - 1;
      submit.hidden = i !== total - 1;
      err.hidden = true;
      if (i === total - 1) loadTurnstile();
    };

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Field-level errors (GOV.UK "Recover from validation errors"): a specific message next to each
    // problem answer, aria-invalid + aria-describedby on the control, and focus on the first problem.
    const clearErrors = (scope: HTMLElement) => {
      scope.querySelectorAll<HTMLElement>('[data-error-slot]').forEach((slot) => {
        slot.hidden = true;
        slot.textContent = '';
      });
      scope.querySelectorAll('.has-error').forEach((el) => el.classList.remove('has-error'));
      scope.querySelectorAll<HTMLElement>('[aria-invalid="true"], [aria-describedby*="-err-"]').forEach((el) => {
        el.removeAttribute('aria-invalid');
        const ids = (el.getAttribute('aria-describedby') || '').split(' ').filter((x) => x && !x.includes('-err-'));
        if (ids.length) el.setAttribute('aria-describedby', ids.join(' '));
        else el.removeAttribute('aria-describedby');
      });
      err.hidden = true;
      err.textContent = '';
    };
    const slotFor = (el: HTMLElement) => {
      const name = (el as HTMLInputElement).name;
      return form.querySelector<HTMLElement>(`[id$="-err-${name}"]`);
    };
    const validStep = (s: HTMLElement) => {
      const problems: { control: HTMLElement; msg: string }[] = [];
      s.querySelectorAll<HTMLFieldSetElement>('fieldset[data-error-msg]').forEach((fs) => {
        const radios = fs.querySelectorAll<HTMLInputElement>('input[type="radio"]');
        if (radios.length && ![...radios].some((r) => r.checked)) problems.push({ control: radios[0], msg: fs.dataset.errorMsg || 'Choose an answer' });
      });
      s.querySelectorAll<HTMLInputElement>('input:not([type="radio"]):not([type="hidden"])').forEach((f) => {
        if (f.closest('.visually-hidden')) return; // honeypot
        const v = f.value.trim();
        if (f.type === 'checkbox') {
          if (f.required && !f.checked) problems.push({ control: f, msg: f.dataset.errorMsg || 'Check this box' });
        } else if (f.required && !v) {
          problems.push({ control: f, msg: f.dataset.errorMsg || 'Fill in this field' });
        } else if (f.name === 'phone' && v.replace(/\D/g, '').length < 10) {
          problems.push({ control: f, msg: f.dataset.errorFormat || 'Enter a 10-digit phone number' });
        } else if (f.name === 'email' && v && !/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(v)) {
          problems.push({ control: f, msg: f.dataset.errorFormat || 'Enter a valid email address' });
        }
      });
      return problems;
    };
    const showErrors = (problems: { control: HTMLElement; msg: string }[]) => {
      for (const { control, msg } of problems as { control: HTMLInputElement; msg: string }[]) {
        const slot = slotFor(control);
        const group = control.closest('fieldset') || control;
        group.classList.add('has-error');
        if (slot) {
          slot.innerHTML = `<span class="visually-hidden">Error: </span>${msg}`;
          slot.hidden = false;
        }
        // Radios: the message is tied to the fieldset (GOV.UK pattern); text fields and the checkbox get aria-invalid.
        const target = (control as HTMLInputElement).type === 'radio' ? group : control;
        if (target === control) target.setAttribute('aria-invalid', 'true');
        if (slot) target.setAttribute('aria-describedby', [target.getAttribute('aria-describedby'), slot.id].filter(Boolean).join(' '));
      }
      // Short summary by the buttons, announced once (role="alert"), worded like the inline messages.
      err.textContent = problems.length === 1 ? problems[0].msg : `There are ${problems.length} problems: ${problems.map((p) => p.msg.toLowerCase()).join('; ')}.`;
      err.hidden = false;
      const first = problems[0].control;
      first.focus({ preventScroll: true });
      (first.closest('fieldset') || first).scrollIntoView({ block: 'center', behavior: reduceMotion ? 'auto' : 'smooth' });
    };

    // Auto-advance only after a tap or click. Arrow keys also change radios, and moving to the next
    // question on a key press would be a change of context on input (WCAG 3.2.2).
    let pointerAt = 0;
    form.addEventListener('pointerdown', (e) => {
      if ((e.target as HTMLElement).closest('.qf-option')) pointerAt = Date.now();
    });

    form.addEventListener('change', (e) => {
      const t = e.target as HTMLInputElement;
      if (!started) {
        started = true;
        track('form_start', { page: location.pathname });
      }
      if (t.name === 'state' && otherState) otherState.hidden = t.value !== 'other';
      if (t.type === 'radio') {
        const fs = t.closest('fieldset');
        if (fs?.classList.contains('has-error')) clearErrors(fs as HTMLElement);
      }
      // Auto-advance on single-question radio steps, for taps and clicks only.
      if (t.type === 'radio' && Date.now() - pointerAt < 1500 && i < total - 1 && steps[i].querySelectorAll('fieldset').length === 1) {
        setTimeout(() => go(1), 180);
      }
    });

    const go = (d: number) => {
      clearErrors(steps[i]);
      if (d > 0) {
        const problems = validStep(steps[i]);
        if (problems.length) return showErrors(problems);
        track('form_step', { step: i + 1 });
      }
      i = Math.max(0, Math.min(total - 1, i + d));
      render();
      const first = steps[i].querySelector<HTMLElement>('input, select');
      first?.focus({ preventScroll: true });
      form.scrollIntoView({ block: 'nearest', behavior: reduceMotion ? 'auto' : 'smooth' });
    };

    next.addEventListener('click', () => go(1));
    back.addEventListener('click', () => go(-1));

    let sending = false;
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      // Enter on an earlier question means "Next", never "send a half-finished form".
      if (i < total - 1) return go(1);
      if (sending) return; // no double sends; the button stays focusable (no disabled state)
      clearErrors(steps[i]);
      const problems = validStep(steps[i]);
      if (problems.length) return showErrors(problems);
      sending = true;
      submit.setAttribute('aria-disabled', 'true');
      submit.textContent = 'Sending…';
      const data = Object.fromEntries(new FormData(form).entries());
      try {
        const res = await fetch('/api/lead', {
          method: 'POST',
          headers: { 'content-type': 'application/json', accept: 'application/json' },
          body: JSON.stringify(data),
        });
        const out = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error(out.error || 'Something went wrong.');
        track('form_submit', { state: data.state, coverage: data.coverage });
        const ref = String(out.id || '').replace(/-/g, '').slice(0, 8).toUpperCase();
        try {
          if (out.id && out.token) sessionStorage.setItem('ot_lead', JSON.stringify({ id: out.id, token: out.token, first: data.first_name }));
        } catch {}
        location.href = `/thank-you/?n=${encodeURIComponent(String(data.first_name || ''))}${ref ? `&ref=${ref}` : ''}`;
      } catch (ex) {
        err.textContent = `${(ex as Error).message} You can also call us directly.`;
        err.hidden = false;
        sending = false;
        submit.removeAttribute('aria-disabled');
        submit.textContent = 'Get my quote';
      }
    });

    const prefill = (value: string, scroll: boolean) => {
      const radio = form.querySelector<HTMLInputElement>(`input[name="coverage"][value="${value}"]`);
      if (!radio) return;
      radio.checked = true;
      if (scroll) {
        form.scrollIntoView({ block: 'start', behavior: reduceMotion ? 'auto' : 'smooth' });
        steps[i].querySelector<HTMLElement>('input, select')?.focus({ preventScroll: true });
      }
    };
    const fromUrl = new URLSearchParams(location.search).get('coverage');
    if (fromUrl) prefill(fromUrl, false);
    if (form === document.querySelector('[data-quote-form]')) {
      document.addEventListener('ot:prefill-coverage', (e) => prefill(String((e as CustomEvent).detail), true));
    }

    render();
  });
</script>
